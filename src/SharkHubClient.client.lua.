local function makeButton(text, y, callback)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -24, 0, 38)
	button.Position = UDim2.fromOffset(12, y)
	button.BackgroundColor3 = Color3.fromRGB(22, 38, 60)
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = Color3.fromRGB(235, 245, 255)
	button.Font = Enum.Font.GothamSemibold
	button.TextSize = 13
	button.AutoButtonColor = true
	button.Parent = main

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 8)
	buttonCorner.Parent = button

	button.Activated:Connect(function()
		local ok, err = pcall(callback)

		if ok then
			status.Text = "Status: " .. text
			status.TextColor3 = Color3.fromRGB(100, 220, 160)
		else
			status.Text = "Erro: confira o módulo"
			status.TextColor3 = Color3.fromRGB(255, 100, 100)
			warn("[SHARK HUB]", err)
		end
	end)

	return button
end

local espEnabled = false

makeButton("ESP de NPCs: alternar", 104, function()
	espEnabled = not espEnabled
	esp:SetEnabled(espEnabled)
end)

makeButton("Câmera: FOV padrão", 150, function()
	local ok, value = cameraTools:SetFieldOfView(70)
	assert(ok, value)
end)

makeButton("Câmera: FOV amplo", 196, function()
	local ok, value = cameraTools:SetFieldOfView(85)
	assert(ok, value)
end)

makeButton("Voo de teste: desativar", 242, function()
	flight:Disable()
end)

makeButton("Restaurar configurações", 288, function()
	espEnabled = false
	esp:SetEnabled(false)
	flight:Disable()
	cameraTools:Reset()
	status.Text = "Status: configurações restauradas"
end)

gui.Destroying:Connect(function()
	esp:Destroy()
	flight:Destroy()
end)

print("[SHARK HUB] Interface de desenvolvimento carregada.")
