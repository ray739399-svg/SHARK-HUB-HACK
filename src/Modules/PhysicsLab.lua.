
-- SHARK HUB | PhysicsLab.lua
-- Laboratório de física para NPCs de treinamento autorizados.

local PhysicsLab = {}

local Workspace = game:GetService("Workspace")

local PhysicsLabController = {}
PhysicsLabController.__index = PhysicsLabController

function PhysicsLab.new(config)
	config = config or {}

	local self = setmetatable({}, PhysicsLabController)

	self.FolderName = config.FolderName or "SharkTraining"
	self.MaxForce = config.MaxForce or 50000
	self.MaxVelocity = config.MaxVelocity or 40

	return self
end

function PhysicsLabController:_getTarget(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return nil, "O alvo precisa ser um Model."
	end

	local folder = Workspace:FindFirstChild(self.FolderName)

	if not folder or not model:IsDescendantOf(folder) then
		return nil, "O alvo não está na pasta de treinamento."
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root or root.Anchored then
		return nil, "NPC sem Humanoid ou raiz física válida."
	end

	return root
end

function PhysicsLabController:ApplyImpulse(model, direction, strength)
	local root, err = self:_getTarget(model)

	if not root then
		return false, err
	end

	if typeof(direction) ~= "Vector3"
		or direction.Magnitude == 0 then
		return false, "Direção inválida."
	end

	if typeof(strength) ~= "number" then
		return false, "A intensidade precisa ser numérica."
	end

	strength = math.clamp(strength, 0, self.MaxForce)

	local impulse = direction.Unit * strength
	root:ApplyImpulse(impulse)

	return true
end

function PhysicsLabController:SetVelocity(model, velocity)
	local root, err = self:_getTarget(model)

	if not root then
		return false, err
	end

	if typeof(velocity) ~= "Vector3" then
		return false, "A velocidade precisa ser um Vector3."
	end

	if velocity.Magnitude > self.MaxVelocity then
		velocity = velocity.Unit * self.MaxVelocity
	end

	root.AssemblyLinearVelocity = velocity

	return true
end

function PhysicsLabController:Stop(model)
	local root, err = self:_getTarget(model)

	if not root then
		return false, err
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	return true
end

return PhysicsLab
